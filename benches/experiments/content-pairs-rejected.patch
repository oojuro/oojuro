+#[test]
+fn ordered_pairs_disambiguate_equal_word_counts_without_future_or_revision_leaks() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    db.insert(r("ordered", "first", "red green blue", 1, 1))?;
+    db.insert(r("reverse", "second", "red blue green", 2, 2))?;
+    let selected = db.find("red green", 0, 3, 10)?;
+    assert_eq!(selected.matches[0].id, "ordered");
+    assert_eq!(db.metrics().pair_terms, 1);
+    let expected_difference =
+        (1. + 1. / (MU * ((1. + literal_probability("red\0green")) / 5.)) as f64).log2();
+    assert!(
+        (selected.matches[0].score_bits - selected.matches[1].score_bits - expected_difference)
+            .abs()
+            < 1e-12
+    );
+    assert_eq!(db.find("red blue", 0, 3, 10)?.matches[0].id, "reverse");
+    let before = db.find("green red", 0, 3, 10)?;
+    assert_eq!(db.metrics().pair_terms, 0);
+    db.insert(r("future", "future", "green red fresh", 30, 30))?;
+    let after = db.find("green red", 0, 3, 10)?;
+    assert_eq!(serde_json::to_vec(&before)?, serde_json::to_vec(&after)?);
+    assert_eq!(db.metrics().pair_terms, 0);
+    db.insert(r("revised", "second", "red green blue", 2, 5))?;
+    assert_eq!(db.find("red green", 0, 3, 10)?.matches[0].id, "ordered");
+    let updated = db.find("red green", 0, 6, 10)?;
+    assert_eq!(updated.matches[0].id, "revised");
+    assert!(!updated.matches.iter().any(|m| m.id == "reverse"));
+    db.find("\"red green\"", 0, 6, 10)?;
+    assert_eq!(db.metrics().pair_terms, 0);
+    assert!(db.stats()?.pair_vocabulary > 0);
+    drop(db);
+    let mut db = Nine::open(&tmp.0)?;
+    assert_eq!(db.find("red green", 0, 3, 10)?.matches[0].id, "ordered");
+    assert_eq!(db.read("ordered").unwrap(), "red green blue");
+    Ok(())
+}
