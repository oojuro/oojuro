+#[test]
+fn field_mixture_sparse_scores_match_independent_dense_historical_views() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    let words = [
+        "alpha", "beta", "gamma", "delta", "running", "runs", "file", "files", "theta",
+    ];
+    for i in 0..120 {
+        let body = (0..(13 + i % 43))
+            .map(|j| words[(i + j * (1 + i % 3)) % words.len()])
+            .collect::<Vec<_>>()
+            .join(" ");
+        let mut row = r(
+            &format!("mixed-{i}"),
+            &format!("key-{}", i % 60),
+            &body,
+            (i / 10) as i64,
+            (i / 10 + i % 3) as i64,
+        );
+        if i % 4 != 0 {
+            row.metadata.insert(
+                "provenance".into(),
+                format!(
+                    "quartz {}",
+                    (0..(5 + i % 12))
+                        .map(|j| words[(2 * i + j) % words.len()])
+                        .collect::<Vec<_>>()
+                        .join(" ")
+                ),
+            );
+        }
+        db.insert(row)?;
+    }
+    for at in [3, 8, 20] {
+        for from in [i64::MIN, 2] {
+            for text in [
+                "alpha beta",
+                "beta beta gamma",
+                "quartz files",
+                "running files",
+                "unknownword alpha",
+            ] {
+                let mut q = Query::new(text, at);
+                q.known_at = at - 1;
+                q.k = 250;
+                let mut query = query_terms(text);
+                let mut rows = Vec::new();
+                for (i, row) in db
+                    .rows
+                    .iter()
+                    .enumerate()
+                    .filter(|(i, row)| row.record.valid_at >= from && db.latest(*i, &q))
+                {
+                    let mut body = BTreeMap::<String, usize>::new();
+                    let mut meta = BTreeMap::<String, usize>::new();
+                    for w in retrieval_terms(&row.record.text) {
+                        *body.entry(normalize_word(&w).into_owned()).or_default() += 1;
+                    }
+                    for w in row.record.metadata.values().flat_map(|v| tokens(v)) {
+                        *meta.entry(normalize_word(&w).into_owned()).or_default() += 1;
+                    }
+                    let bm = query.keys().any(|w| body.contains_key(w));
+                    let mm = query.keys().any(|w| meta.contains_key(w));
+                    rows.push((i, body, meta, bm, mm));
+                }
+                let total = rows
+                    .iter()
+                    .map(|(_, b, m, bm, mm)| {
+                        usize::from(*bm) * b.values().sum::<usize>()
+                            + usize::from(*mm) * m.values().sum::<usize>()
+                    })
+                    .sum::<usize>();
+                let cf: BTreeMap<_, _> = query
+                    .keys()
+                    .map(|w| {
+                        (
+                            w.clone(),
+                            rows.iter()
+                                .map(|(_, b, m, bm, mm)| {
+                                    usize::from(*bm) * b.get(w).copied().unwrap_or(0)
+                                        + usize::from(*mm) * m.get(w).copied().unwrap_or(0)
+                                })
+                                .sum::<usize>(),
+                        )
+                    })
+                    .collect();
+                query.retain(|w, _| cf[w] > 0);
+                let fielded = rows.iter().any(|(_, _, _, _, mm)| *mm);
+                let mut dense = HashMap::new();
+                for (i, b, m, bm, mm) in &rows {
+                    if !bm && !mm {
+                        continue;
+                    }
+                    let nb = b.values().sum::<usize>() as f64;
+                    let nm = m.values().sum::<usize>() as f64;
+                    let mut score = 0.;
+                    for (w, n) in &query {
+                        let bg = (cf[w] as f64 + literal_probability(w)) / (total as f64 + 1.);
+                        let pb = (b.get(w).copied().unwrap_or(0) as f64 + 128. * bg) / (nb + 128.);
+                        let pm = (m.get(w).copied().unwrap_or(0) as f64 + 128. * bg) / (nm + 128.);
+                        let p = if fielded && nm > 0. {
+                            (2. * pb + pm) / 3.
+                        } else {
+                            pb
+                        };
+                        score += *n as f64 * (p / bg).log2();
+                    }
+                    dense.insert(db.rows[*i].record.id.clone(), score);
+                }
+                let found = db.search_refs(&q, from)?;
+                assert_eq!(found.matches.len(), dense.len());
+                for hit in &found.matches {
+                    assert!((hit.score_bits - dense[&hit.id]).abs() < 1e-10);
+                }
+                assert!(
+                    found
+                        .matches
+                        .windows(2)
+                        .all(|v| v[0].score_bits + 1e-10 >= v[1].score_bits)
+                );
+                q.k = 3;
+                assert_eq!(
+                    db.search_refs(&q, from)?
+                        .matches
+                        .iter()
+                        .map(|m| &m.id)
+                        .collect::<Vec<_>>(),
+                    found
+                        .matches
+                        .iter()
+                        .take(3)
+                        .map(|m| &m.id)
+                        .collect::<Vec<_>>()
+                );
+            }
+        }
+    }
+    Ok(())
+}
