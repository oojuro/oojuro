+#[test]
+fn fractional_query_counts_match_hand_computed_dense_scores() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    for (id, text) in [
+        ("a", "alpha alpha beta"),
+        ("b", "beta beta gamma"),
+        ("c", "unrelated alpha"),
+    ] {
+        db.insert(r(id, id, text, 1, 1))?;
+    }
+    let weighted = BTreeMap::from([("alpha".to_string(), 0.25), ("beta".to_string(), 0.75)]);
+    let q = Query::new("alpha beta", 5);
+    let (found, _) = db.rank_terms(&q, i64::MIN, Some(weighted))?;
+    let p_alpha = (3. + literal_probability("alpha")) / 9.;
+    let p_beta = (3. + literal_probability("beta")) / 9.;
+    let counts = [("a", 2., 1., 3.), ("b", 0., 2., 3.), ("c", 1., 0., 2.)];
+    for hit in found.matches {
+        let (_, a, b, n) = counts.iter().find(|(id, _, _, _)| *id == hit.id).unwrap();
+        let expected = 0.25 * ((a + 128. * p_alpha) / ((n + 128.) * p_alpha)).log2()
+            + 0.75 * ((b + 128. * p_beta) / ((n + 128.) * p_beta)).log2();
+        assert!((hit.score_bits - expected).abs() < 1e-10);
+    }
+    Ok(())
+}
