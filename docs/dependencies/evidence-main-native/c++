#!/bin/sh
set -eu
export ZIG_GLOBAL_CACHE_DIR="${OOJURO_DEP_ZIG_CACHE:?}"
export ZIG_LOCAL_CACHE_DIR="${OOJURO_DEP_ZIG_CACHE:?}"
for arg in "$@"; do
 case "$arg" in --target=*|-Wl,--no-undefined-version|-march=native|-mtune=native) ;; *) set -- "$@" "$arg" ;; esac
 shift
done
exec /home/rocket2/.sa-agents/oojuro-toolchain/zig/zig c++ -target x86_64-linux-gnu.2.39 -mcpu=baseline "$@"
