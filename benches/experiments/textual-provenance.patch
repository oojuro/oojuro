+    #[test]
+    fn metadata_control_has_matching_value_scope_and_body_only_literals() -> Result<()> {
+        let temp = std::env::temp_dir();
+        let path = temp.join(format!(
+            "nine-metadata-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)?
+                .as_nanos()
+        ));
+        let result = (|| -> Result<()> {
+            let mut pair = Pair::open(&path)?;
+            let mut old = Record::new("old", "revision", "Exact original body.", 10);
+            old.metadata.insert(
+                "unsearchablefieldname".into(),
+                "docs/zephyr_notes.md".into(),
+            );
+            pair.put(&old, "fixture")?;
+            let mut late = Record::new("late", "revision", "Replacement body.", 20);
+            late.recorded_at = 50;
+            late.metadata
+                .insert("path".into(), "docs/meridian.md".into());
+            pair.put(&late, "fixture")?;
+            let mut future = Record::new("future", "other", "Future body.", 100);
+            future
+                .metadata
+                .insert("path".into(), "zephyr zephyr zephyr".into());
+            pair.put(&future, "fixture")?;
+            pair.sql.enable_identifiers()?;
+            for porter in [false, true] {
+                if porter {
+                    pair.sql.enable_porter()?;
+                }
+                pair.sql.enable_metadata()?;
+                for (question, at, wanted) in [
+                    ("zephyr", 30, vec!["old"]),
+                    ("\"zephyr\"", 30, vec![]),
+                    ("unsearchablefieldname", 30, vec![]),
+                    ("zephyr", 60, vec![]),
+                ] {
+                    let c = Case {
+                        id: "fixture".into(),
+                        question: question.into(),
+                        evidence: Vec::new(),
+                        at,
+                    };
+                    let native = pair.nine.search_refs(&Query::new(question, at), 0)?;
+                    let sql = pair.sql.rank(&c, 50)?;
+                    assert_eq!(
+                        native
+                            .matches
+                            .iter()
+                            .map(|m| m.id.as_str())
+                            .collect::<Vec<_>>(),
+                        wanted
+                    );
+                    assert_eq!(
+                        sql.iter().map(|(id, _)| id.as_str()).collect::<Vec<_>>(),
+                        wanted
+                    );
+                }
+            }
+            assert_eq!(pair.sql.read("old")?.text, old.text);
+            assert_eq!(pair.sql.read("old")?.metadata, old.metadata);
+            Ok(())
+        })();
+        if let (Ok(target), Ok(parent)) = (path.canonicalize(), temp.canonicalize()) {
+            if target.parent() == Some(parent.as_path()) {
+                fs::remove_dir_all(target)?;
+            }
+        }
+        result
+    }
+
