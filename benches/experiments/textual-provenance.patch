index 4149246..b5aa7fc 100644
--- a/crates/oojuro-nine/src/tests.rs
+++ b/crates/oojuro-nine/src/tests.rs
@@ -69,0 +70,66 @@
+#[test]
+fn metadata_values_are_searchable_but_literals_originals_and_both_clocks_stay_exact() -> Result<()>
+{
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    let mut old = r(
+        "old",
+        "revision",
+        "Exact original body without the topic word.",
+        10,
+        10,
+    );
+    old.metadata.insert(
+        "unsearchablefieldname".into(),
+        "docs/zephyr_notes.md".into(),
+    );
+    db.insert(old.clone())?;
+    let q = Query::new("zephyr", 30);
+    let before = db.search_refs(&q, 0)?;
+    assert_eq!(
+        before
+            .matches
+            .iter()
+            .map(|m| m.id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["old"]
+    );
+    let mut late = r("late", "revision", "Replacement body.", 20, 50);
+    late.metadata
+        .insert("path".into(), "docs/meridian.md".into());
+    db.insert(late)?;
+    let mut future = r("future", "other", "Future body.", 100, 100);
+    future
+        .metadata
+        .insert("path".into(), "zephyr zephyr zephyr".into());
+    db.insert(future)?;
+    assert_eq!(
+        serde_json::to_vec(&db.search_refs(&q, 0)?)?,
+        serde_json::to_vec(&before)?
+    );
+    assert!(
+        db.search_refs(&Query::new("\"zephyr\"", 30), 0)?
+            .matches
+            .is_empty()
+    );
+    assert!(
+        db.search_refs(&Query::new("unsearchablefieldname", 30), 0)?
+            .matches
+            .is_empty()
+    );
+    assert!(
+        db.search_refs(&Query::new("zephyr", 60), 0)?
+            .matches
+            .is_empty()
+    );
+    assert_eq!(db.read("old"), Some(old.text.as_str()));
+    drop(db);
+    let mut db = Nine::open(&tmp.0)?;
+    assert_eq!(
+        serde_json::to_vec(&db.search_refs(&q, 0)?)?,
+        serde_json::to_vec(&before)?
+    );
+    assert_eq!(db.record("old").unwrap().metadata, old.metadata);
+    Ok(())
+}
