+    #[test]
+    fn native_bm25_matches_sqlite_scores_for_identical_word_features() -> Result<()> {
+        let temp = std::env::temp_dir();
+        let path = temp.join(format!(
+            "nine-bm25-parity-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)?
+                .as_nanos()
+        ));
+        let result = (|| -> Result<()> {
+            let mut pair = Pair::open(&path)?;
+            for (id, body) in [
+                ("a", "alpha beta"),
+                ("b", "alpha alpha beta beta gamma"),
+                ("c", "gamma delta"),
+                ("d", "epsilon epsilon"),
+                ("e", "zeta eta theta"),
+            ] {
+                pair.put(&Record::new(id, id, body, 1), "fixture")?;
+            }
+            for question in ["alpha", "beta alpha", "alpha alpha beta"] {
+                let mut q = Query::new(question, 2);
+                q.k = 10;
+                let native = pair.nine.search_refs(&q, i64::MIN)?;
+                let mut stmt = pair.sql.db.prepare("SELECT s.id,-bm25(fts) FROM fts JOIN sources s ON s.rowid=fts.rowid WHERE fts MATCH ?1 ORDER BY bm25(fts),s.id")?;
+                let sql = stmt
+                    .query_map([expression(question, true)], |r| {
+                        Ok((r.get::<_, String>(0)?, r.get::<_, f64>(1)?))
+                    })?
+                    .collect::<rusqlite::Result<Vec<_>>>()?;
+                assert_eq!(native.matches.len(), sql.len());
+                for (hit, (id, nats)) in native.matches.iter().zip(sql) {
+                    assert_eq!(hit.id, id);
+                    assert!((hit.score_bits * std::f64::consts::LN_2 - nats).abs() < 1e-12);
+                }
+            }
+            Ok(())
+        })();
+        if let (Ok(target), Ok(parent)) = (path.canonicalize(), temp.canonicalize()) {
+            if target.parent() == Some(parent.as_path()) {
+                fs::remove_dir_all(target)?;
+            }
+        }
+        result
+    }
