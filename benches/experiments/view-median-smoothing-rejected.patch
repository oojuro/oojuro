@@ -870,0 +884,16 @@ impl Engine for Nine {
+fn median_length(mut lengths: Vec<usize>) -> f64 {
+    if lengths.is_empty() {
+        return MU;
+    }
+    let even = lengths.len() % 2 == 0;
+    let middle = lengths.len() / 2;
+    let (lower, upper, _) = lengths.select_nth_unstable(middle);
+    let upper = *upper as f64;
+    let lower = if even {
+        *lower.iter().max().unwrap() as f64
+    } else {
+        upper
+    };
+    ((lower + upper) / 2.).max(1.)
+}
