+#[test]
+fn ordered_pair_cache_overflow_preserves_counts_and_normalized_forms() {
+    let mut text = (0..4201)
+        .map(|i| format!("word{i}"))
+        .collect::<Vec<_>>()
+        .join(" ");
+    text.push_str(" workers are running Workers are running");
+    let pairs = pair_terms(&text);
+    assert_eq!(pairs.get("worker\0run"), Some(&2));
+    assert_eq!(pairs, reference_pairs(&text));
+}
