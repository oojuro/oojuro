+    fn enable_metadata(&mut self) -> Result<()> {
+        let (table, tokenizer) = if self.word_table == "fts_porter" {
+            (
+                "fts_metadata_porter",
+                "porter unicode61 remove_diacritics 0",
+            )
+        } else {
+            ("fts_metadata", "unicode61 remove_diacritics 0")
+        };
+        let exists: bool = self.db.query_row(
+            "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE name=?1)",
+            [table],
+            |r| r.get(0),
+        )?;
+        if !exists {
+            let tx = self.db.unchecked_transaction()?;
+            tx.execute_batch(&format!(
+                "CREATE VIRTUAL TABLE {table} USING fts5(body,provenance,tokenize='{tokenizer}')"
+            ))?;
+            {
+                let mut read = tx.prepare("SELECT rowid,body,metadata FROM sources")?;
+                let mut write = tx.prepare(&format!(
+                    "INSERT INTO {table}(rowid,body,provenance) VALUES(?1,?2,?3)"
+                ))?;
+                let mut rows = read.query([])?;
+                while let Some(row) = rows.next()? {
+                    let metadata: BTreeMap<String, String> =
+                        serde_json::from_str(row.get_ref(2)?.as_str()?)?;
+                    let provenance = metadata
+                        .values()
+                        .map(String::as_str)
+                        .collect::<Vec<_>>()
+                        .join("\n");
+                    write.execute(params![
+                        row.get::<_, i64>(0)?,
+                        row.get_ref(1)?.as_str()?,
+                        provenance
+                    ])?;
+                }
+            }
+            tx.commit()?;
+        }
+        self.word_table = table;
+        Ok(())
+    }
