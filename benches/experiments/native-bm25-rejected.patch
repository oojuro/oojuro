+#[test]
+fn bm25_statistics_include_nonmatches_and_exclude_future_and_superseded_sources() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    db.insert(r("early", "state", "alpha alpha beta", 1, 1))?;
+    db.insert(r("other", "other", "alpha beta beta beta", 1, 1))?;
+    db.insert(r("noise", "noise", "omega omega", 1, 1))?;
+    let before = db.find("alpha", 0, 3, 10)?;
+    assert_eq!(db.metrics().bm25_documents, 3);
+    assert_eq!(db.metrics().bm25_average_length, 3.);
+    db.insert(r("future", "future", "alpha future future", 30, 30))?;
+    db.insert(r("revised", "state", "alpha beta omega omega omega", 2, 5))?;
+    let after = db.find("alpha", 0, 3, 10)?;
+    assert_eq!(serde_json::to_vec(&before)?, serde_json::to_vec(&after)?);
+    assert_eq!(db.metrics().bm25_documents, 3);
+    let current = db.find("alpha", 0, 6, 10)?;
+    assert!(
+        !current
+            .matches
+            .iter()
+            .any(|m| m.id == "early" || m.id == "future")
+    );
+    assert_eq!(db.metrics().bm25_documents, 3);
+    assert_eq!(db.metrics().bm25_average_length, 11. / 3.);
+    assert_eq!(db.find("alpha", 2, 6, 10)?.matches[0].id, "revised");
+    assert_eq!(db.metrics().bm25_documents, 1);
+    db.find("key:state", 0, 6, 10)?;
+    assert_eq!(db.metrics().bm25_documents, 0);
+    assert!(db.metrics().best_conditional_query_bits.is_some());
