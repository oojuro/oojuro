+#[test]
+fn full_query_scoring_preserves_candidate_support_and_historical_counts() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    db.insert(r("z-useful", "useful", "the quartz", 1, 1))?;
+    db.insert(r("a-other", "other", "quartz cobalt", 1, 1))?;
+    db.insert(r("function-only", "function-only", "the the the", 1, 1))?;
+    let q = Query::new("the quartz", 5);
+    let first = db.search_refs(&q, i64::MIN)?;
+    assert_eq!(first.matches.len(), 2);
+    assert_eq!(first.matches[0].id, "z-useful");
+    // Only the two content-matching records enter C: length 4, the=1, quartz=2.
+    let p_the = (1. + literal_probability("the")) / 5.;
+    let p_quartz = (2. + literal_probability("quartz")) / 5.;
+    let expected = ((1. + 128. * p_the) / (130. * p_the)).log2()
+        + ((1. + 128. * p_quartz) / (130. * p_quartz)).log2();
+    assert!((first.matches[0].score_bits - expected).abs() < 1e-10);
+    let projection = |m: &Matches| {
+        m.matches
+            .iter()
+            .map(|m| (m.id.clone(), m.score_bits))
+            .collect::<Vec<_>>()
+    };
+    let before = projection(&first);
+    db.insert(r("unrelated", "unrelated", &"the ".repeat(20_000), 1, 1))?;
+    db.insert(r("future", "future", "the quartz quartz", 9, 1))?;
+    db.insert(r("late-known", "useful", "quartz revised", 3, 9))?;
+    assert_eq!(projection(&db.search_refs(&q, i64::MIN)?), before);
+    let mut revised = q.clone();
+    revised.known_at = 10;
+    let updated = db.search_refs(&revised, i64::MIN)?;
+    assert!(!updated.matches.iter().any(|m| m.id == "z-useful"));
+    assert!(updated.matches.iter().any(|m| m.id == "late-known"));
+    assert!(db.search_refs(&q, 2)?.matches.is_empty());
+    assert!(
+        db.search_refs(&Query::new("the unknownword", 5), i64::MIN)?
+            .matches
+            .is_empty()
+    );
+    // The existing all-stopword fallback must not count these words twice.
+    let once = db.search_refs(&Query::new("the", 5), i64::MIN)?;
+    let twice = db.search_refs(&Query::new("the the", 5), i64::MIN)?;
+    assert_eq!(once.matches.len(), twice.matches.len());
+    for (a, b) in once.matches.iter().zip(&twice.matches) {
+        assert_eq!(a.id, b.id);
+        assert!((2. * a.score_bits - b.score_bits).abs() < 1e-10);
+    }
+    drop(db);
+    let mut db = Nine::open(&tmp.0)?;
+    assert_eq!(projection(&db.search_refs(&q, i64::MIN)?), before);
+    assert_eq!(db.read("z-useful"), Some("the quartz"));
+    Ok(())
+}
