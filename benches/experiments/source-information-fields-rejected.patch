+#[test]
+fn field_information_streaming_scores_match_dense_historical_views() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    let words = [
+        "alpha", "beta", "gamma", "delta", "running", "runs", "file", "files", "theta",
+    ];
+    for i in 0..120 {
+        let body = (0..(13 + i % 43))
+            .map(|j| words[(i + j * (1 + i % 3)) % words.len()])
+            .collect::<Vec<_>>()
+            .join(" ");
+        let mut row = r(
+            &format!("mixed-{i}"),
+            &format!("key-{}", i % 60),
+            &body,
+            (i / 10) as i64,
+            (i / 10 + i % 3) as i64,
+        );
+        if i % 4 != 0 {
+            row.metadata.insert(
+                "provenance".into(),
+                format!(
+                    "quartz {}",
+                    (0..(5 + i % 12))
+                        .map(|j| words[(2 * i + j) % words.len()])
+                        .collect::<Vec<_>>()
+                        .join(" ")
+                ),
+            );
+        }
+        db.insert(row)?;
+    }
+    for at in [3, 8, 20] {
+        for from in [i64::MIN, 2] {
+            for text in [
+                "alpha beta",
+                "beta beta gamma",
+                "quartz files",
+                "running files",
+                "unknownword alpha",
+            ] {
+                let mut q = Query::new(text, at);
+                q.known_at = at - 1;
+                q.k = 250;
+                let mut query = query_terms(text);
+                let mut rows = Vec::new();
+                for (i, row) in db
+                    .rows
+                    .iter()
+                    .enumerate()
+                    .filter(|(i, row)| row.record.valid_at >= from && db.latest(*i, &q))
+                {
+                    let mut body = BTreeMap::<String, usize>::new();
+                    let mut meta = BTreeMap::<String, usize>::new();
+                    for w in retrieval_terms(&row.record.text) {
+                        *body.entry(normalize_word(&w).into_owned()).or_default() += 1;
+                    }
+                    for w in row.record.metadata.values().flat_map(|v| tokens(v)) {
+                        *meta.entry(normalize_word(&w).into_owned()).or_default() += 1;
+                    }
+                    let bm = query.keys().any(|w| body.contains_key(w));
+                    let mm = query.keys().any(|w| meta.contains_key(w));
+                    rows.push((i, body, meta, bm, mm));
+                }
+                let fielded = rows.iter().any(|(_, _, _, _, mm)| *mm);
+                let tb = rows
+                    .iter()
+                    .filter(|(_, _, _, bm, _)| fielded || *bm)
+                    .map(|(_, b, _, _, _)| b.values().sum::<usize>())
+                    .sum::<usize>();
+                let tm = rows
+                    .iter()
+                    .filter(|(_, _, _, _, mm)| fielded || *mm)
+                    .map(|(_, _, m, _, _)| m.values().sum::<usize>())
+                    .sum::<usize>();
+                let cb: BTreeMap<_, _> = query
+                    .keys()
+                    .map(|w| {
+                        (
+                            w.clone(),
+                            rows.iter()
+                                .filter(|(_, _, _, bm, _)| *bm)
+                                .map(|(_, b, _, _, _)| b.get(w).copied().unwrap_or(0))
+                                .sum::<usize>(),
+                        )
+                    })
+                    .collect();
+                let cm: BTreeMap<_, _> = query
+                    .keys()
+                    .map(|w| {
+                        (
+                            w.clone(),
+                            rows.iter()
+                                .filter(|(_, _, _, _, mm)| *mm)
+                                .map(|(_, _, m, _, _)| m.get(w).copied().unwrap_or(0))
+                                .sum::<usize>(),
+                        )
+                    })
+                    .collect();
+                query.retain(|w, _| cb[w] + cm[w] > 0);
+                let words: Vec<_> = query.keys().collect();
+                let mut body_cf: Vec<_> = words.iter().map(|w| cb[*w]).collect();
+                body_cf.push(tb - cb.values().sum::<usize>());
+                let mut meta_cf: Vec<_> = words.iter().map(|w| cm[*w]).collect();
+                meta_cf.push(tm - cm.values().sum::<usize>());
+                let mut prior: Vec<_> = words.iter().map(|w| literal_probability(w)).collect();
+                prior.push(1. - prior.iter().sum::<f64>());
+                let mut bb = Vec::new();
+                let mut mb = Vec::new();
+                let mut weights = Vec::new();
+                for j in 0..prior.len() {
+                    let common = (body_cf[j] as f64 + meta_cf[j] as f64 + prior[j])
+                        / ((tb + tm) as f64 + 1.);
+                    bb.push(if fielded {
+                        (body_cf[j] as f64 + common) / (tb as f64 + 1.)
+                    } else {
+                        (body_cf[j] as f64 + prior[j]) / (tb as f64 + 1.)
+                    });
+                    mb.push((meta_cf[j] as f64 + common) / (tm as f64 + 1.));
+                    let be = if tb > 0 {
+                        body_cf[j] as f64 / tb as f64
+                    } else {
+                        0.
+                    };
+                    let me = if tm > 0 {
+                        meta_cf[j] as f64 / tm as f64
+                    } else {
+                        0.
+                    };
+                    let source_information = if fielded && j < words.len() {
+                        let count = rows.len() as f64;
+                        let body_matches = rows
+                            .iter()
+                            .filter(|(_, b, _, _, _)| b.contains_key(words[j]))
+                            .count();
+                        let meta_matches = rows
+                            .iter()
+                            .filter(|(_, _, m, _, _)| m.contains_key(words[j]))
+                            .count();
+                        Some((
+                            if body_matches == 0 {
+                                0.
+                            } else {
+                                (count / body_matches as f64).log2()
+                            },
+                            if meta_matches == 0 {
+                                0.
+                            } else {
+                                (count / meta_matches as f64).log2()
+                            },
+                        ))
+                    } else {
+                        None
+                    };
+                    weights.push(if !fielded {
+                        1.
+                    } else if let Some((body, metadata)) = source_information {
+                        if 2. * body + metadata > 0. {
+                            2. * body / (2. * body + metadata)
+                        } else {
+                            2. / 3.
+                        }
+                    } else if 2. * be + me > 0. {
+                        2. * be / (2. * be + me)
+                    } else {
+                        2. / 3.
+                    });
+                }
+                let reference: Vec<_> = (0..prior.len())
+                    .map(|j| weights[j] * bb[j] + (1. - weights[j]) * mb[j])
+                    .collect();
+                let reference_total = reference.iter().sum::<f64>();
+                let mut dense = HashMap::new();
+                for (i, b, m, bm, mm) in &rows {
+                    if !bm && !mm {
+                        continue;
+                    }
+                    let nb = b.values().sum::<usize>() as f64;
+                    let nm = m.values().sum::<usize>() as f64;
+                    let mut bc: Vec<_> = words
+                        .iter()
+                        .map(|w| b.get(*w).copied().unwrap_or(0) as f64)
+                        .collect();
+                    bc.push(nb - bc.iter().sum::<f64>());
+                    let mut mc: Vec<_> = words
+                        .iter()
+                        .map(|w| m.get(*w).copied().unwrap_or(0) as f64)
+                        .collect();
+                    mc.push(nm - mc.iter().sum::<f64>());
+                    let raw: Vec<_> = (0..prior.len())
+                        .map(|j| {
+                            let pb = (bc[j] + 128. * bb[j]) / (nb + 128.);
+                            let pm = (mc[j] + 128. * mb[j]) / (nm + 128.);
+                            if fielded && nm > 0. {
+                                weights[j] * pb + (1. - weights[j]) * pm
+                            } else {
+                                pb
+                            }
+                        })
+                        .collect();
+                    let normalizer = raw.iter().sum::<f64>();
+                    let score = query
+                        .values()
+                        .enumerate()
+                        .map(|(j, n)| {
+                            *n as f64
+                                * ((raw[j] / normalizer) / (reference[j] / reference_total)).log2()
+                        })
+                        .sum::<f64>();
+                    dense.insert(db.rows[*i].record.id.clone(), score);
+                }
+                let found = db.search_refs(&q, from)?;
+                assert_eq!(found.matches.len(), dense.len());
+                for hit in &found.matches {
+                    assert!((hit.score_bits - dense[&hit.id]).abs() < 1e-10);
+                }
+                assert!(
+                    found
+                        .matches
+                        .windows(2)
+                        .all(|v| v[0].score_bits + 1e-10 >= v[1].score_bits)
+                );
+                q.k = 3;
+                assert_eq!(
+                    db.search_refs(&q, from)?
+                        .matches
+                        .iter()
+                        .map(|m| &m.id)
+                        .collect::<Vec<_>>(),
+                    found
+                        .matches
+                        .iter()
+                        .take(3)
+                        .map(|m| &m.id)
+                        .collect::<Vec<_>>()
+                );
+            }
+        }
+    }
+    Ok(())
+}
