+fn pair_terms(text: &str) -> HashMap<String, usize> {
+    let mut pairs = HashMap::new();
+    let mut previous = None;
+    let mut forms = HashMap::new();
+    for raw in text
+        .split(|c: char| !c.is_alphanumeric() && c != '_')
+        .filter(|s| s.chars().any(char::is_alphanumeric))
+    {
+        let form = || {
+            let word = raw.to_lowercase();
+            (!QUERY_STOP_WORDS.contains(&word.as_str())).then(|| normalize_word(&word).into_owned())
+        };
+        let word = if forms.len() < 4096 || forms.contains_key(raw) {
+            forms.entry(raw).or_insert_with(form).clone()
+        } else {
+            form()
+        };
+        let Some(word) = word else { continue };
+        if let Some(prior) = previous.as_ref() {
+            *pairs.entry(format!("{prior}\0{word}")).or_default() += 1;
+        }
+        previous = Some(word);
+    }
+    pairs
+}
