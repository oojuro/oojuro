+#[test]
+fn field_information_matches_hand_probabilities_and_preserves_originals() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    let mut a = r("a", "a", "alpha alpha beta", 1, 1);
+    a.metadata.insert("provenance".into(), "beta gamma".into());
+    let b = r("b", "b", "beta beta gamma", 1, 1);
+    let mut c = r("c", "c", "delta", 1, 1);
+    c.metadata.insert("provenance".into(), "alpha alpha".into());
+    let originals = [a, b, c];
+    for row in &originals {
+        db.insert(row.clone())?;
+    }
+    let q = Query::new("alpha beta", 2);
+    let found = db.search_refs(&q, i64::MIN)?;
+    assert_eq!(found.matches.len(), 3);
+    assert_eq!(db.metrics().provenance_records, 2);
+    let ba = (4. + literal_probability("alpha")) / 12.;
+    let bb = (4. + literal_probability("beta")) / 12.;
+    let bo = (4. - literal_probability("alpha") - literal_probability("beta")) / 12.;
+    let body_bg = [(2. + ba) / 8., (3. + bb) / 8., (2. + bo) / 8.];
+    let meta_bg = [(2. + ba) / 5., (1. + bb) / 5., (1. + bo) / 5.];
+    let beta_body_information = 2. * (3.0f64 / 2.).log2();
+    let body_weight = [
+        2. / 3.,
+        beta_body_information / (beta_body_information + 3.0f64.log2()),
+        16. / 23.,
+    ];
+    let reference: Vec<_> = (0..3)
+        .map(|j| body_weight[j] * body_bg[j] + (1. - body_weight[j]) * meta_bg[j])
+        .collect();
+    let reference_total = reference.iter().sum::<f64>();
+    let dense = [
+        ("a", [2., 1.], 3., [0., 1.], 2.),
+        ("b", [0., 2.], 3., [0., 0.], 0.),
+        ("c", [0., 0.], 1., [2., 0.], 2.),
+    ];
+    for hit in &found.matches {
+        let (_, body, nb, meta, nm) = dense.iter().find(|(id, ..)| *id == hit.id).unwrap();
+        let body_counts = [body[0], body[1], nb - body[0] - body[1]];
+        let meta_counts = [meta[0], meta[1], nm - meta[0] - meta[1]];
+        let raw: Vec<_> = (0..3)
+            .map(|j| {
+                let pb = (body_counts[j] + 128. * body_bg[j]) / (nb + 128.);
+                let pm = (meta_counts[j] + 128. * meta_bg[j]) / (nm + 128.);
+                if *nm > 0. {
+                    body_weight[j] * pb + (1. - body_weight[j]) * pm
+                } else {
+                    pb
+                }
+            })
+            .collect();
+        let normalizer = raw.iter().sum::<f64>();
+        let expected = (0..2)
+            .map(|j| ((raw[j] / normalizer) / (reference[j] / reference_total)).log2())
+            .sum::<f64>();
+        assert!((expected - hit.score_bits).abs() < 1e-10);
+    }
+    assert_eq!(db.stats()?.metadata_postings, 3);
+    let fallback = db.find("delta", i64::MIN, 2, 10)?;
+    let bg = (1. + literal_probability("delta")) / 2.;
+    let expected = ((1. + 128. * bg) / (129. * bg)).log2();
+    assert_eq!(db.metrics().provenance_records, 0);
+    assert!((fallback.matches[0].score_bits - expected).abs() < 1e-10);
+    assert!(db.find("provenance", i64::MIN, 2, 10)?.matches.is_empty());
+    let projection = |m: &Matches| {
+        m.matches
+            .iter()
+            .map(|m| (m.id.clone(), m.score_bits))
+            .collect::<Vec<_>>()
+    };
+    let before = projection(&found);
+    drop(db);
+    let mut db = Nine::open(&tmp.0)?;
+    assert_eq!(projection(&db.search_refs(&q, i64::MIN)?), before);
+    for original in originals {
+        assert_eq!(
+            serde_json::to_vec(db.record(&original.id).unwrap())?,
+            serde_json::to_vec(&original)?
+        );
+    }
+    Ok(())
+}
