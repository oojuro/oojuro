+#[test]
+fn exclusive_field_words_and_other_have_normalized_code_probabilities() {
+    let alpha = field_map(2, 0, 4, 3, literal_probability("alpha"));
+    let quartz = field_map(0, 2, 4, 3, literal_probability("quartz"));
+    let other = field_map(
+        2,
+        1,
+        4,
+        3,
+        1. - literal_probability("alpha") - literal_probability("quartz"),
+    );
+    assert_eq!(alpha.body_weight, 1.);
+    assert_eq!(alpha.metadata_weight, 0.);
+    assert_eq!(quartz.body_weight, 0.);
+    assert_eq!(quartz.metadata_weight, 1.);
+    let raw = [alpha.reference(), quartz.reference(), other.reference()];
+    let total = raw.iter().sum::<f64>();
+    assert!(total > 1.4); // A word-dependent mixture needs normalization.
+    assert!((raw.iter().map(|p| p / total).sum::<f64>() - 1.).abs() < 1e-12);
+    let empty_other = field_map(0, 0, 4, 3, 1.);
+    assert_eq!(empty_other.body_weight, 2. / 3.);
+    assert_eq!(empty_other.metadata_weight, 1. / 3.);
+}
