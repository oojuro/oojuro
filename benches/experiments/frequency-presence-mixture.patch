+#[test]
+fn mixture_probabilities_normalize_with_extreme_component_scores() {
+    let score = mixture_scores(&[-10000., 0., -10000.], &[0., -10000., -10000.]);
+    assert!(score.iter().all(|x| x.is_finite()));
+    assert!((score.iter().map(|x| x.exp2() / 3.).sum::<f64>() - 1.).abs() < 1e-12);
+    assert_eq!(score[0], score[1]);
+    assert_eq!(mixture_scores(&[10000.], &[-10000.]), vec![0.]);
+    assert!(mixture_scores(&[], &[]).is_empty());
+}
