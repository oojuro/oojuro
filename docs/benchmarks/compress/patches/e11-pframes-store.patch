+/// P-frame payload: zstd against `reference` (raw body of an earlier I-frame)
+/// as prefix, no dictionary; `delta` = first_seq distance to that frame.
+#[allow(clippy::too_many_arguments)]
+fn pack_body_prefix(level: i32, first_seq: u64, count: usize, body: &[u8], meta_len: usize, delta: u64, reference: &[u8]) -> Result<Vec<u8>> {
+    let mut c = zstd_safe::CCtx::create();
+    c.set_parameter(zstd_safe::CParameter::CompressionLevel(level)).map_err(zerr)?;
+    c.set_parameter(zstd_safe::CParameter::ContentSizeFlag(false)).map_err(zerr)?;
+    c.set_parameter(zstd_safe::CParameter::DictIdFlag(false)).map_err(zerr)?;
+    c.set_parameter(zstd_safe::CParameter::Format(zstd_safe::FrameFormat::Magicless)).map_err(zerr)?;
+    c.ref_prefix(reference).map_err(zerr)?;
+    let mut z = Vec::with_capacity(zstd_safe::compress_bound(body.len()));
+    c.compress2(&mut z, body).map_err(zerr)?;
+    let head = FrameHead {
+        codec: CODEC_ZSTD,
+        dict: 0,
+        first_seq,
+        count: count as u32,
+        raw_len: body.len() as u32,
+        meta_len: meta_len as u32,
+        digest: Some(digest16(body)),
+        prefix: Some(delta),
+        body_at: 0,
+    };
+    let mut payload = Vec::with_capacity(z.len() + 48);
+    put_head(&mut payload, &head);
+    payload.extend_from_slice(&z);
+    Ok(payload)
+}
+
+fn unpack_prefix(packed: &[u8], raw_len: usize, reference: &[u8]) -> Result<Vec<u8>> {
+    let mut d = zstd_safe::DCtx::create();
+    d.set_parameter(zstd_safe::DParameter::Format(zstd_safe::FrameFormat::Magicless)).map_err(zerr)?;
+    d.ref_prefix(reference).map_err(zerr)?;
+    let mut out = Vec::with_capacity(raw_len);
+    d.decompress(&mut out, packed).map_err(zerr)?;
+    Ok(out)
+}
