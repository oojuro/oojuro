+struct FieldMap {
+    body_background: f64,
+    metadata_background: f64,
+    body_weight: f64,
+    metadata_weight: f64,
+}
+impl FieldMap {
+    fn combine(&self, body: f64, metadata: f64, has_metadata: bool) -> f64 {
+        if has_metadata {
+            self.body_weight * body + self.metadata_weight * metadata
+        } else {
+            body
+        }
+    }
+    fn reference(&self) -> f64 {
+        self.combine(self.body_background, self.metadata_background, true)
+    }
+}
+fn field_map(
+    body: usize,
+    metadata: usize,
+    body_total: usize,
+    metadata_total: usize,
+    prior: f64,
+) -> FieldMap {
+    let shared =
+        (body as f64 + metadata as f64 + prior) / ((body_total + metadata_total) as f64 + 1.);
+    let body_rate = if body_total > 0 {
+        body as f64 / body_total as f64
+    } else {
+        0.
+    };
+    let metadata_rate = if metadata_total > 0 {
+        metadata as f64 / metadata_total as f64
+    } else {
+        0.
+    };
+    let evidence = 2. * body_rate + metadata_rate;
+    let (body_weight, metadata_weight) = if evidence > 0. {
+        (2. * body_rate / evidence, metadata_rate / evidence)
+    } else {
+        (2. / 3., 1. / 3.)
+    };
+    FieldMap {
+        body_background: (body as f64 + shared) / (body_total as f64 + 1.),
+        metadata_background: (metadata as f64 + shared) / (metadata_total as f64 + 1.),
+        body_weight,
+        metadata_weight,
+    }
+}
+
+fn information_weights(
+    records: usize,
+    body_documents: usize,
+    metadata_documents: usize,
+) -> (f64, f64) {
+    debug_assert!(body_documents <= records && metadata_documents <= records);
+    let information = |df: usize| {
+        if df > 0 {
+            (records as f64 / df as f64).log2()
+        } else {
+            0.
+        }
+    };
+    let body = 2. * information(body_documents);
+    let metadata = information(metadata_documents);
+    if body + metadata > 0. {
+        (body / (body + metadata), metadata / (body + metadata))
+    } else {
+        (2. / 3., 1. / 3.)
+    }
+}
