+#[test]
+fn feedback_term_cutoff_has_deterministic_ties_and_filters_noise() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    let words = "ba bb bc bd bf bg bh bi bj bk bl bm bn bo bp bq br bt bu bv bw bx bz";
+    let first = format!("needle the and 123 x {words}");
+    db.insert(r("one", "one", &first, 1, 1))?;
+    let q = Query::new("needle", 2);
+    let (seed, _) = db.rank_terms(&q, i64::MIN, None)?;
+    let expanded = db.feedback_query(&q.text, &seed).unwrap();
+    assert_eq!(expanded.len(), 21);
+    assert_eq!(expanded["needl"], 0.5);
+    assert!((expanded["ba"] - 0.025).abs() < 1e-12);
+    for absent in ["the", "and", "123", "x", "bz"] {
+        assert!(!expanded.contains_key(absent));
+    }
+    let reverse = first.split_whitespace().rev().collect::<Vec<_>>().join(" ");
+    db.insert(r("two", "one", &reverse, 2, 2))?;
+    let (seed, _) = db.rank_terms(&q, i64::MIN, None)?;
+    assert_eq!(expanded, db.feedback_query(&q.text, &seed).unwrap());
+    Ok(())
+}
