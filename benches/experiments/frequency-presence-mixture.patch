+/// Equal-weight mixture over candidate-address probabilities. Its
+/// code length pays for two alternatives rather than selecting a favorable one.
+fn mixture_scores(frequency: &[f64], presence: &[f64]) -> Vec<f64> {
+    if frequency.is_empty() {
+        return Vec::new();
+    }
+    let log_sum = |values: &[f64]| {
+        let max = values.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+        max + values.iter().map(|s| (*s - max).exp2()).sum::<f64>().log2()
+    };
+    let zf = log_sum(frequency);
+    let zp = log_sum(presence);
+    let uniform = (frequency.len() as f64).log2();
+    frequency
+        .iter()
+        .zip(presence)
+        .map(|(f, p)| {
+            let (f, p) = (*f - zf, *p - zp);
+            let max = f.max(p);
+            uniform + max + ((f - max).exp2() + (p - max).exp2()).log2() - 1.
+        })
+        .collect()
+}
