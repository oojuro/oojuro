+#[test]
+fn metadata_matches_obey_clocks_ranges_literals_anchors_and_finite_scores() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    let mut old = r("meta-old", "meta-key", "stable original evidence", 1, 1);
+    old.metadata
+        .insert("provenance".into(), "quartz repair_shadow_page".into());
+    db.insert(old.clone())?;
+    db.insert(r("anchor", "anchor", "fn repair_shadow_page() {}", 1, 1))?;
+    let q = Query::new("quartz", 3);
+    let first = db.search_refs(&q, i64::MIN)?;
+    assert_eq!(first.matches[0].id, "meta-old");
+    db.search_refs(&q, i64::MIN)?;
+    assert!(db.metrics().cache_hit);
+    assert_eq!(db.metrics().background_rows_visited, 0);
+    assert!(db.find("\"quartz\"", i64::MIN, 3, 10)?.matches.is_empty());
+    assert_eq!(
+        db.find("repair_shadow_page", i64::MIN, 3, 10)?
+            .matches
+            .iter()
+            .map(|m| m.id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["anchor"]
+    );
+    let mut future = r("future", "future", "future original", 9, 1);
+    future
+        .metadata
+        .insert("provenance".into(), "quartz quartz".into());
+    db.insert(future)?;
+    let mut late = r("late", "meta-key", "revised original", 2, 8);
+    late.metadata.insert("provenance".into(), "cobalt".into());
+    db.insert(late)?;
+    let after_ineligible = db.search_refs(&q, i64::MIN)?;
+    assert_eq!(
+        first.matches[0].score_bits,
+        after_ineligible.matches[0].score_bits
+    );
+    let mut unrelated = r("unrelated", "unrelated", "unrelated body", 2, 2);
+    unrelated
+        .metadata
+        .insert("provenance".into(), "cobalt".into());
+    db.insert(unrelated)?;
+    let after = db.search_refs(&q, i64::MIN)?;
+    assert_eq!(first.matches[0].id, after.matches[0].id);
+    assert!((first.matches[0].score_bits - after.matches[0].score_bits).abs() > 1e-12);
+    assert_eq!(db.metrics().background_records, 3);
+    assert!(!db.metrics().cache_hit);
+    assert!(db.search_refs(&q, 2)?.matches.is_empty());
+    let mut known = q.clone();
+    known.known_at = 8;
+    assert!(db.search_refs(&known, i64::MIN)?.matches.is_empty());
+    let long = "q".repeat(2000);
+    let mut long_row = r("long-meta", "long-meta", "ordinary original", 2, 2);
+    long_row.metadata.insert("provenance".into(), long.clone());
+    db.insert(long_row)?;
+    let found = db.find(&long, i64::MIN, 3, 10)?;
+    assert_eq!(found.matches[0].id, "long-meta");
+    assert!(found.matches.iter().all(|m| m.score_bits.is_finite()));
+    assert_eq!(
+        serde_json::to_vec(db.record("meta-old").unwrap())?,
+        serde_json::to_vec(&old)?
+    );
+    let final_expected = db.search_refs(&q, i64::MIN)?.matches[0].score_bits;
+    drop(db);
+    let mut db = Nine::open(&tmp.0)?;
+    assert_eq!(
+        db.search_refs(&q, i64::MIN)?.matches[0].score_bits,
+        final_expected
+    );
+    Ok(())
+}
