+#[test]
+fn field_information_ignores_ubiquitous_or_absent_fields() {
+    assert_eq!(information_weights(8, 1, 8), (1., 0.));
+    assert_eq!(information_weights(8, 8, 1), (0., 1.));
+    assert_eq!(information_weights(8, 0, 1), (0., 1.));
+    assert_eq!(information_weights(8, 1, 0), (1., 0.));
+    assert_eq!(information_weights(8, 1, 1), (2. / 3., 1. / 3.));
+    assert_eq!(information_weights(8, 8, 8), (2. / 3., 1. / 3.));
+    // Three body bits times its 2:1 prior versus one metadata bit.
+    assert_eq!(information_weights(8, 1, 4), (6. / 7., 1. / 7.));
+}
