+#[test]
+#[ignore = "requires the local public FiQA fixture; diagnostic writes aggregate counts only"]
+fn public_fiqa_feedback_seed_self_exclusion_audit() -> Result<()> {
+    let root = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let output = root.join("results/nine-fiqa-feedback-seed-audit1.json");
+    assert!(!output.exists());
+    let db = Nine::open(&root.join("data/private/nine-fiqa-shared-raw1/nine"))?;
+    let labels = fs::read_to_string(root.join("data/public/fiqa/qrels/test.tsv"))?;
+    let query_ids: BTreeSet<_> = labels
+        .lines()
+        .skip(1)
+        .filter_map(|line| line.split('\t').next())
+        .collect();
+    let queries = fs::read_to_string(root.join("data/public/fiqa/queries.jsonl"))?;
+    let mut collisions = 0;
+    let mut in_seed = 0;
+    for line in queries.lines() {
+        let query: serde_json::Value = serde_json::from_str(line)?;
+        let id = query["_id"].as_str().ok_or("public query ID missing")?;
+        if !query_ids.contains(id) {
+            continue;
+        }
+        let source_id = format!("beir:{id}");
+        if !db.ids.contains_key(&source_id) {
+            continue;
+        }
+        collisions += 1;
+        let mut q = Query::new(
+            query["text"].as_str().ok_or("public query text missing")?,
+            1,
+        );
+        q.k = 10;
+        let (seed, _) = db.rank_terms(&q, i64::MIN, None)?;
+        in_seed += usize::from(seed.matches.iter().any(|m| m.id == source_id));
+    }
+    let result = serde_json::json!({"scope":"public FiQA first-pass self-ID diagnostic",
+        "test_queries":query_ids.len(),"id_collisions":collisions,"excluded_ids_in_feedback_seed":in_seed,
+        "seed_depth":10,"embedding_calls":0,"llm_calls":0});
+    fs::write(output, serde_json::to_vec_pretty(&result)?)?;
+    println!("Public query ID collisions: {collisions}; present in feedback seeds: {in_seed}.");
+    Ok(())
+}
