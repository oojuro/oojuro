+fn reference_pairs(text: &str) -> HashMap<String, usize> {
+    let words: Vec<_> = text
+        .split(|c: char| !c.is_alphanumeric() && c != '_')
+        .filter(|s| s.chars().any(char::is_alphanumeric))
+        .map(str::to_lowercase)
+        .filter(|s| !QUERY_STOP_WORDS.contains(&s.as_str()))
+        .map(|s| normalize_word(&s).into_owned())
+        .collect();
+    let mut counts = HashMap::new();
+    for (a, b) in words.iter().zip(words.iter().skip(1)) {
+        *counts.entry(format!("{a}\0{b}")).or_default() += 1;
+    }
+    counts
