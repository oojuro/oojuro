     assert!(errors > 0);
     let _ = std::fs::remove_dir_all(&dir);
 }
+
+/// Near-duplicates (one edited line per copy) that exact chunk dedupe misses.
+fn near_duplicates(n: usize) -> Vec<Rec> {
+    let base: Vec<String> = (0..400).map(|i| format!("    {i:4}\tvalue_{} = compute(alpha, beta_{}, gamma)\n", i * 7 % 13, i % 11)).collect();
+    (0..n)
+        .map(|k| {
+            let mut lines = base.clone();
+            lines[(k * 37) % 400] = format!("    edit {k}: changed line\n");
+            lines[(k * 91 + 5) % 400] = format!("    another {k}\n");
+            (4u8, 1_700_000_000 + k as i64, Vec::new(), lines.concat().into_bytes())
+        })
+        .collect()
+}
+
+#[test]
+fn pframes_roundtrip_and_stay_deterministic() {
+    let recs = near_duplicates(80);
+    let o = Options { pframes: true, cold_frame_bytes: 16 << 10, ..opts() };
+    let mut images = Vec::new();
+    for n in 0..2 {
+        let dir = temp(&format!("pframes{n}"));
+        let mut s = Store::open(&dir, Options { compact_threads: [1, 3][n], ..o.clone() }).unwrap();
+        append_all(&mut s, &recs, 2);
+        let st = s.compact().unwrap();
+        assert!(st.pframes > 0, "{st:?}");
+        check_all(&s, &recs);
+        drop(s);
+        let s = Store::open(&dir, o.clone()).unwrap();
+        check_all(&s, &recs);
+        drop(s);
+        let mut files: Vec<(String, Vec<u8>)> = std::fs::read_dir(&dir)
+            .unwrap()
+            .map(|e| e.unwrap().path())
+            .map(|p| (p.file_name().unwrap().to_string_lossy().into_owned(), std::fs::read(&p).unwrap()))
+            .collect();
+        files.sort();
+        images.push(files);
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+    assert_eq!(images[0], images[1]);
+}
