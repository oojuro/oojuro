+fn information_weight(count: usize, length: usize, background: f64) -> f64 {
+    if count == 0 || count >= length {
+        return 0.;
+    }
+    let t = count as f64;
+    let f = t / length as f64;
+    (1. - f).powi(2) / (t + 1.)
+        * (t * (f / background).log2() + 0.5 * (2. * std::f64::consts::PI * t * (1. - f)).log2())
+}
