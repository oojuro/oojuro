+#[test]
+fn feedback_query_preserves_mass_clocks_originals_and_final_k_prefix() -> Result<()> {
+    let tmp = Scratch::new();
+    let mut db = Nine::open(&tmp.0)?;
+    db.insert(r("seed", "seed", "nebula nebula cobalt", 1, 1))?;
+    db.insert(r("related", "related", "cobalt cedar", 2, 2))?;
+    let mut q = Query::new("nebula", 5);
+    q.k = 10;
+    let (seed, _) = db.rank_terms(&q, i64::MIN, None)?;
+    let expanded = db.feedback_query(&q.text, &seed).unwrap();
+    assert!((expanded["nebula"] - 5. / 6.).abs() < 1e-12);
+    assert!((expanded["cobalt"] - 1. / 6.).abs() < 1e-12);
+    assert!((expanded.values().sum::<f64>() - 1.).abs() < 1e-12);
+    let before = db.search_refs(&q, i64::MIN)?;
+    assert!(before.matches.iter().any(|m| m.id == "related"));
+    let projection = |m: &Matches| {
+        m.matches
+            .iter()
+            .map(|m| (m.id.clone(), m.score_bits))
+            .collect::<Vec<_>>()
+    };
+    db.insert(r("future", "future", "nebula futuresecret", 10, 1))?;
+    db.insert(r("late", "seed", "nebula willow", 3, 9))?;
+    let (after_seed, _) = db.rank_terms(&q, i64::MIN, None)?;
+    assert_eq!(expanded, db.feedback_query(&q.text, &after_seed).unwrap());
+    assert_eq!(
+        projection(&before),
+        projection(&db.search_refs(&q, i64::MIN)?)
+    );
+    assert!(db.search_refs(&q, 2)?.matches.is_empty());
+    let mut known = q.clone();
+    known.known_at = 10;
+    let (new_seed, _) = db.rank_terms(&known, i64::MIN, None)?;
+    assert!(
+        db.feedback_query(&q.text, &new_seed)
+            .unwrap()
+            .contains_key("willow")
+    );
+    q.k = 1;
+    let one = db.search_refs(&q, i64::MIN)?;
+    assert_eq!(one.matches[0].id, before.matches[0].id);
+    assert_eq!(one.matches[0].score_bits, before.matches[0].score_bits);
+    assert_eq!(db.read("seed"), Some("nebula nebula cobalt"));
+    drop(db);
+    let mut db = Nine::open(&tmp.0)?;
+    q.k = 10;
+    assert_eq!(
+        projection(&before),
+        projection(&db.search_refs(&q, i64::MIN)?)
+    );
+    Ok(())
+}
